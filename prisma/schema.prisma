generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String?
  image         String?
  role          Role          @default(READER)
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  auditLogs     AuditLog[]
  bookmarks     Bookmark[]
  comments      Comment[]
  commentLikes  CommentLike[]
  posts         Post[]        @relation("PostAuthor")
  sessions      Session[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Category {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  nameHi String
  posts  Post[]

  @@index([slug])
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  posts PostTag[]

  @@index([slug])
}

model Post {
  id               String     @id @default(cuid())
  slug             String     @unique
  headline         String
  dek              String
  body             String
  status           PostStatus @default(DRAFT)
  featuredImageUrl String
  featuredImageAlt String
  metaDescription  String?
  readingTimeMin   Int        @default(3)
  views            Int        @default(0)
  isBreaking       Boolean    @default(false)
  isLive           Boolean    @default(false)
  locale           Locale     @default(EN)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  authorId         String
  categoryId       String
  bodyHi           String?
  dekHi            String?
  headlineHi       String?
  bookmarks        Bookmark[]
  comments         Comment[]
  media            Media[]
  author           User       @relation("PostAuthor", fields: [authorId], references: [id])
  category         Category   @relation(fields: [categoryId], references: [id])
  tags             PostTag[]

  @@index([status])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([categoryId, status])
  @@index([publishedAt])
  @@index([slug, status])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Comment {
  id           String        @id @default(cuid())
  text         String
  likes        Int           @default(0)
  createdAt    DateTime      @default(now())
  postId       String
  authorId     String
  status       CommentStatus @default(PENDING)
  author       User          @relation(fields: [authorId], references: [id])
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likesByUsers CommentLike[]

  @@index([postId])
  @@index([postId, createdAt])
  @@index([authorId])
  @@index([createdAt])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Media {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  altText   String?
  createdAt DateTime  @default(now())
  postId    String?
  post      Post?     @relation(fields: [postId], references: [id])

  @@index([postId])
}

model Advertisement {
  id          String      @id @default(cuid())
  name        String
  placement   AdPlacement
  imageUrl    String
  targetUrl   String
  status      AdStatus    @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([placement, status])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  active       Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

model Redirect {
  id         String @id @default(cuid())
  fromPath   String @unique
  toPath     String
  statusCode Int    @default(301)
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model LiveChannel {
  id        String   @id @default(cuid())
  name      String
  streamUrl String
  logoUrl   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LiveSchedule {
  id        String    @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime?
  channelId String?
  createdAt DateTime  @default(now())
}

model FactCheck {
  id          String   @id @default(cuid())
  claim       String
  summary     String
  verdict     String
  publishedAt DateTime @default(now())
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String?
  videoUrl     String
  category     String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
}

model Epaper {
  id           String   @id @default(cuid())
  title        String
  editionDate  DateTime
  pdfUrl       String
  thumbnailUrl String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([editionDate])
  @@index([published])
}

model Menu {
  id        String     @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]

  @@index([location])
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String
  title     String
  url       String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  titleHi   String?
  body      String
  bodyHi    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model WidgetArea {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  widgets   Widget[]
}

model Widget {
  id        String     @id @default(cuid())
  areaId    String
  name      String
  slug      String
  enabled   Boolean    @default(true)
  order     Int        @default(0)
  config    Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  area      WidgetArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId])
  @@index([enabled])
  @@index([order])
}

enum Role {
  READER
  JOURNALIST
  EDITOR
  ADMIN
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AdPlacement {
  LEADERBOARD
  SIDEBAR
  INLINE
  STICKY
  NATIVE
}

enum AdStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum Locale {
  EN
  HI
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}
