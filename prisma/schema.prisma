// AZEEL NEWS — Prisma schema
// Postgres as primary datastore; Redis (see lib/redis.ts) handles caching,
// rate limiting, and session/token storage — not modeled here since it's
// key-value, not relational.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  READER
  JOURNALIST
  EDITOR
  ADMIN
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AdPlacement {
  LEADERBOARD
  SIDEBAR
  INLINE
  STICKY
  NATIVE
}

enum AdStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum Locale {
  EN
  HI
}

// ---------- Auth ----------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String? // null for OAuth-only accounts
  image         String?
  role          Role      @default(READER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  posts    Post[]    @relation("PostAuthor")
  comments Comment[]
  bookmarks Bookmark[]
  auditLogs AuditLog[]

  @@index([role])
}

// OAuth provider links (Google, etc.) — provider-agnostic so it works
// whether the JWT layer is hand-rolled or built on an auth library.
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // e.g. "google"
  providerAccountId String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------- Content ----------

model Category {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  nameHi String
  posts  Post[]
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts PostTag[]
}

model Post {
  id               String     @id @default(cuid())
  slug             String     @unique
  headline         String
  dek              String     @db.Text
  body             String     @db.Text // Markdown
  status           PostStatus @default(DRAFT)
  featuredImageUrl String
  featuredImageAlt String
  metaDescription  String?
  readingTimeMin   Int        @default(3)
  views            Int        @default(0)
  isBreaking       Boolean    @default(false)
  isLive           Boolean    @default(false)
  locale           Locale     @default(EN)

  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId   String
  author     User     @relation("PostAuthor", fields: [authorId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  tags      PostTag[]
  comments  Comment[]
  bookmarks Bookmark[]
  media     Media[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

// Explicit join table (rather than an implicit m2m) so tag usage can carry
// its own metadata later (e.g. relevance score) without a migration.
model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String   @db.Text
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  @@index([postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Media {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  altText   String?
  createdAt DateTime  @default(now())

  postId String?
  post   Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)
}

// ---------- Monetization ----------

model Advertisement {
  id          String      @id @default(cuid())
  name        String
  placement   AdPlacement
  imageUrl    String
  targetUrl   String
  status      AdStatus    @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([placement, status])
}

// ---------- Engagement ----------

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  active       Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

// ---------- Site management ----------

model Redirect {
  id         String @id @default(cuid())
  fromPath   String @unique
  toPath     String
  statusCode Int    @default(301)
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "post.publish", "user.role_change"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}
